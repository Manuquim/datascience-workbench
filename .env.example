# Copy to .env. Keys remain in the backend; never put .env in Git.
OPENAI_API_KEY=
# Set an API model available in your account that supports Responses structured outputs.
OPENAI_MODEL=

# Optional absolute path. If empty/omitted, defaults to ./data.
# DSW_DATA_DIR=C:/Users/Manuel/DataScienceWorkbench-data
DSW_MEMORY_LIMIT=4GB
DSW_THREADS=2
DSW_TEMP_LIMIT=20GB
DSW_MAX_UPLOAD_GB=10
DSW_JOB_TIMEOUT=1800
